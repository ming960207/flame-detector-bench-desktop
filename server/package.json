{
  "name": "flame-detector-unified-server",
  "version": "1.0.0",
  "description": "火焰探测器检测台统一后端：现场监测、测试监听与 MQTT 上传",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "tsx --test test/product-profile-precheck.test.ts test/product-code-relay.test.ts test/relay-functional-test-coordinator.test.ts",
    "test:product": "tsx --test test/product-profile-precheck.test.ts test/product-code-relay.test.ts test/relay-functional-test-coordinator.test.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.5",
    "modbus-serial": "^8.0.17",
    "mqtt": "^5.15.1",
    "multer": "^2.0.2",
    "nodes7": "^0.3.18",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
